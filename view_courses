// Fetch all courses
$query_all_courses = "SELECT id, course_name FROM courses";
$result_all_courses = mysqli_query($conn, $query_all_courses);
$all_courses = [];
if (mysqli_num_rows($result_all_courses) > 0) {
    while ($course = mysqli_fetch_assoc($result_all_courses)) {
        $all_courses[] = $course;
    }
}

